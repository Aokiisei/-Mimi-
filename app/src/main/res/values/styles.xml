<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.WuyiKebiao" parent="@style/Theme.Material3.DayNight.NoActionBar">
            <!-- Claude 温暖纸张设计系统：统一 material 控件配色 -->
            <item name="colorPrimary">@color/cl_terracotta</item>
            <item name="colorOnPrimary">@color/cl_ivory</item>
            <item name="colorSecondary">@color/cl_coral</item>
            <item name="colorOnSecondary">@color/cl_ivory</item>
            <item name="colorSurface">@color/cl_ivory</item>
            <item name="colorOnSurface">@color/cl_ink</item>
            <item name="colorOutline">@color/cl_border_warm</item>
            <item name="android:colorBackground">@color/cl_parchment</item>
            <item name="android:windowBackground">@color/cl_parchment</item>
            <item name="android:statusBarColor">@color/cl_parchment</item>
            <item name="android:navigationBarColor">@color/cl_parchment</item>
            <item name="android:windowLightStatusBar">true</item>
        </style>
    <style name="Theme.Splash" parent="@style/Theme.AppCompat.NoActionBar">
            <item name="android:windowBackground">@drawable/splash_bg</item>
            <item name="android:windowFullscreen">true</item>
        </style>
    <style name="Theme.WuyiKebiao" parent="@style/Base.Theme.WuyiKebiao" />
    <style name="TextAppearance.Wuyi.NavLabel" parent="@style/TextAppearance.Material3.LabelSmall">
            <item name="android:textSize">9sp</item>
            <item name="android:textStyle">normal</item>
        </style>
    <style name="Widget.Wuyi.BottomNavIndicator" parent="@style/Widget.Material3.BottomNavigationView.ActiveIndicator">
            <item name="android:width">34dp</item>
            <item name="android:height">22dp</item>
            <item name="android:color">#1FC96442</item>
        </style>
</resources>
